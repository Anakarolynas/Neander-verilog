// ============================================================
// NEANDER - Operações lógicas OR e NOT
//
// Combina dois valores com OR e depois inverte o resultado. Como o
// OR preenche todos os bits, o NOT devolve zero — o que também deixa
// a flag Z em 1 no final.
//
//     11110000   (240, em 40)
//   | 00001111   (15,  em 41)
//   ----------
//     11111111
//   NOT
//   ----------
//     00000000
//
// Endereço  Instrução   Efeito
// --------  ----------  ------------------------------------------
//    0      LDA 40      AC = 11110000
//    2      OR  41      AC = 11111111
//    4      NOT         AC = 00000000   (instrução sem operando)
//    5      STA 42      memoria[42] = 0
//    7      HLT
//
// Resultado esperado: AC = 0, memoria[42] = 0, flag Z = 1
// ============================================================

00100000   // 0  - LDA
00101000   // 1  -   endereco 40
01000000   // 2  - OR
00101001   // 3  -   endereco 41
01100000   // 4  - NOT
00010000   // 5  - STA
00101010   // 6  -   endereco 42
11110000   // 7  - HLT
00000000   // 8
00000000   // 9
00000000   // 10
00000000   // 11
00000000   // 12
00000000   // 13
00000000   // 14
00000000   // 15
00000000   // 16
00000000   // 17
00000000   // 18
00000000   // 19
00000000   // 20
00000000   // 21
00000000   // 22
00000000   // 23
00000000   // 24
00000000   // 25
00000000   // 26
00000000   // 27
00000000   // 28
00000000   // 29
00000000   // 30
00000000   // 31
00000000   // 32
00000000   // 33
00000000   // 34
00000000   // 35
00000000   // 36
00000000   // 37
00000000   // 38
00000000   // 39
11110000   // 40 - dado: 11110000
00001111   // 41 - dado: 00001111
00000000   // 42 - resultado
