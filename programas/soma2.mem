// ============================================================
// NEANDER - Soma de três valores
//
// Acumula três parcelas no AC e grava o total em 43. Mostra que o
// acumulador mantém o resultado parcial entre operações da ULA.
//
// Endereço  Instrução   Efeito
// --------  ----------  ------------------------------------------
//    0      LDA 40      AC = 10
//    2      ADD 41      AC = 10 + 20 = 30
//    4      ADD 42      AC = 30 + 7  = 37
//    6      STA 43      memoria[43] = 37
//    8      HLT
//
// Resultado esperado: AC = 37, memoria[43] = 37
// ============================================================

00100000   // 0  - LDA
00101000   // 1  -   endereco 40
00110000   // 2  - ADD
00101001   // 3  -   endereco 41
00110000   // 4  - ADD
00101010   // 5  -   endereco 42
00010000   // 6  - STA
00101011   // 7  -   endereco 43
11110000   // 8  - HLT
00000000   // 9
00000000   // 10
00000000   // 11
00000000   // 12
00000000   // 13
00000000   // 14
00000000   // 15
00000000   // 16
00000000   // 17
00000000   // 18
00000000   // 19
00000000   // 20
00000000   // 21
00000000   // 22
00000000   // 23
00000000   // 24
00000000   // 25
00000000   // 26
00000000   // 27
00000000   // 28
00000000   // 29
00000000   // 30
00000000   // 31
00000000   // 32
00000000   // 33
00000000   // 34
00000000   // 35
00000000   // 36
00000000   // 37
00000000   // 38
00000000   // 39
00001010   // 40 - dado: 10
00010100   // 41 - dado: 20
00000111   // 42 - dado: 7
00000000   // 43 - resultado da soma
