// ============================================================
// NEANDER - Soma de dois valores
//
// Soma os valores guardados em 40 e 41 e grava o resultado em 42.
//
// Endereço  Instrução   Efeito
// --------  ----------  ------------------------------------------
//    0      LDA 40      AC = 5
//    2      ADD 41      AC = 5 + 3 = 8
//    4      STA 42      memoria[42] = 8
//    6      HLT
//
// Resultado esperado: AC = 8, memoria[42] = 8
// ============================================================

00100000   // 0  - LDA
00101000   // 1  -   endereco 40
00110000   // 2  - ADD
00101001   // 3  -   endereco 41
00010000   // 4  - STA
00101010   // 5  -   endereco 42
11110000   // 6  - HLT
00000000   // 7
00000000   // 8
00000000   // 9
00000000   // 10
00000000   // 11
00000000   // 12
00000000   // 13
00000000   // 14
00000000   // 15
00000000   // 16
00000000   // 17
00000000   // 18
00000000   // 19
00000000   // 20
00000000   // 21
00000000   // 22
00000000   // 23
00000000   // 24
00000000   // 25
00000000   // 26
00000000   // 27
00000000   // 28
00000000   // 29
00000000   // 30
00000000   // 31
00000000   // 32
00000000   // 33
00000000   // 34
00000000   // 35
00000000   // 36
00000000   // 37
00000000   // 38
00000000   // 39
00000101   // 40 - dado: 5
00000011   // 41 - dado: 3
00000000   // 42 - resultado da soma
