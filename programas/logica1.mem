// ============================================================
// NEANDER - Operação lógica AND (máscara de bits)
//
// Aplica uma máscara sobre um valor, mantendo apenas os bits que
// estão em 1 nos dois operandos.
//
//     11110000   (240, em 40)
//   & 00111100   (60,  em 41)
//   ----------
//     00110000   (48)
//
// Endereço  Instrução   Efeito
// --------  ----------  ------------------------------------------
//    0      LDA 40      AC = 11110000
//    2      AND 41      AC = 00110000
//    4      STA 42      memoria[42] = 00110000
//    6      HLT
//
// Resultado esperado: AC = 48, memoria[42] = 48
// ============================================================

00100000   // 0  - LDA
00101000   // 1  -   endereco 40
01010000   // 2  - AND
00101001   // 3  -   endereco 41
00010000   // 4  - STA
00101010   // 5  -   endereco 42
11110000   // 6  - HLT
00000000   // 7
00000000   // 8
00000000   // 9
00000000   // 10
00000000   // 11
00000000   // 12
00000000   // 13
00000000   // 14
00000000   // 15
00000000   // 16
00000000   // 17
00000000   // 18
00000000   // 19
00000000   // 20
00000000   // 21
00000000   // 22
00000000   // 23
00000000   // 24
00000000   // 25
00000000   // 26
00000000   // 27
00000000   // 28
00000000   // 29
00000000   // 30
00000000   // 31
00000000   // 32
00000000   // 33
00000000   // 34
00000000   // 35
00000000   // 36
00000000   // 37
00000000   // 38
00000000   // 39
11110000   // 40 - dado: 11110000
00111100   // 41 - mascara: 00111100
00000000   // 42 - resultado
